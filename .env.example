# Local development environment for `mix phx.server`.
#
# The app does not load this file. Copy it to `.env` and source it:
#
#   set -a
#   source .env
#   set +a
#
# or export the values directly in your shell.
#
# There are no required secret environment variables. The vault key, admin
# password, inbound route keys, and SECRET_KEY_BASE are not read from the
# environment.

# Optional: sign-in username. Defaults to "admin". Not secret.
# export ADMIN_USER="admin"

# Optional listeners. Both bind to 127.0.0.1 and the ports must differ.
# OUTBOUND_PORT serves the UI, admin, /health, and outbound /r routes.
# INBOUND_PORT serves /health and the inbound catch-all (tunnel origin).
export OUTBOUND_PORT=4000
export INBOUND_PORT=4001

# Optional proxy limits.
export UPSTREAM_TIMEOUT_MS=30000
export MAX_BODY_BYTES=10485760

# Recommended: avoid writing the in-memory vault key to a crash dump.
export ERL_CRASH_DUMP_SECONDS=0
