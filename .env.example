# Local development environment for `mix phx.server`.
#
# The app does not load this file. Copy it to `.env` and source it:
#
#   set -a
#   source .env
#   set +a
#
# or export the values directly in your shell.

# Required: base64-encoded 32-byte AES key used to encrypt route headers.
# Generate one with:
#   elixir -e 'IO.puts(Base.encode64(:crypto.strong_rand_bytes(32)))'
CLOAK_KEY="replace-with-a-base64-encoded-32-byte-key"

# Required: shared key inbound callers send as X-Proxy-Key.
INBOUND_PROXY_KEY="replace-with-a-long-random-string"

# Required: HTTP basic auth for /routes and /admin.
ADMIN_USER="admin"
ADMIN_PASSWORD="replace-with-a-strong-password"

# Optional listeners. Both bind to 127.0.0.1 and the ports must differ.
# OUTBOUND_PORT serves the UI, admin, /health, and outbound /r routes.
# INBOUND_PORT serves /health and the inbound catch-all (tunnel origin).
OUTBOUND_PORT=4000
INBOUND_PORT=4001

# Optional proxy limits.
UPSTREAM_TIMEOUT_MS=30000
MAX_BODY_BYTES=10485760
